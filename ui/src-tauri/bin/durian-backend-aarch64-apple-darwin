#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Walk up directories until we find a directory with .venv and main.py
ROOT_DIR="$DIR"
while [ "$ROOT_DIR" != "/" ]; do
  if [ -f "$ROOT_DIR/main.py" ] && [ -d "$ROOT_DIR/.venv" ]; then
    break
  fi
  ROOT_DIR="$(dirname "$ROOT_DIR")"
done

if [ "$ROOT_DIR" = "/" ]; then
  echo "Error: Could not find project root directory containing main.py and .venv" >&2
  exit 1
fi

cd "$ROOT_DIR"
exec ./.venv/bin/python main.py
